    def test_{{operationId}}_paginated_multiple_pages(self) -> None:
    {{/async}}
        """Test {{operationId}}_fetch_all_items following pagination links.

        Verifies that:
        - Follows 'next' Link header
        - Stops when no next link present
        - Yields correct number of items
        """
        from unittest.mock import call

        {{#isArray}}
        mock_page_data = [MagicMock(), MagicMock()]
        {{/isArray}}
        {{^isArray}}
        mock_page_data = MagicMock()
        {{/isArray}}

        # Mock three pages: page1 -> page2 -> page3 (last)
        page1_response = MagicMock()
        page1_response.headers = {
            'Link': '<https://canvas.example.com/api/v1/endpoint?page=2>; rel="next"'
        }
        page1_response.read = AsyncMock()

        page2_response = MagicMock()
        page2_response.headers = {
            'Link': '<https://canvas.example.com/api/v1/endpoint?page=3>; rel="next"'
        }
        page2_response.read = AsyncMock()

        page3_response = MagicMock()
        page3_response.headers = {}  # No next link
        page3_response.read = AsyncMock()

        # Setup mock to return different responses for different URLs
        call_count = [0]
        async def mock_call_api(*args, **kwargs):
            call_count[0] += 1
            if call_count[0] == 1:
                return page1_response
            elif call_count[0] == 2:
                return page2_response
            else:
                return page3_response

        self.api.api_client.call_api = AsyncMock(side_effect=mock_call_api)

        mock_response_data = MagicMock()
        mock_response_data.data = mock_page_data
        self.api.api_client.response_deserialize = MagicMock(
            return_value=mock_response_data
        )

        # Collect all items
        items = []
        async for item in self.api.{{operationId}}_all(
            {{#allParams}}
            {{paramName}}={{#isString}}"invalid"{{/isString}}{{#isInteger}}999{{/isInteger}}{{#isNumber}}999.9{{/isNumber}}{{#isBoolean}}False{{/isBoolean}}{{#isArray}}[]{{/isArray}}{{^isPrimitiveType}}{{^isArray}}None{{/isArray}}{{/isPrimitiveType}},
            {{/allParams}}
        ):
            items.append(item)

        # Should have items from 3 pages
        {{#isArray}}
        assert len(items) == 3 * len(mock_page_data)  # 3 pages × items per page
        {{/isArray}}
        {{^isArray}}
        assert len(items) == 3  # 3 pages, one item each
        {{/isArray}}
        assert call_count[0] == 3

